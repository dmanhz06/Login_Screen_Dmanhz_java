<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- HEADER -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgHeader"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img"
        app:shapeAppearanceOverlay="@style/RoundedBottomImage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TITLE -->
    <TextView
        android:id="@+id/tvEditTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Post"
        android:textColor="@android:color/white"
        android:textSize="44sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toTopOf="@id/imgHeader"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- INPUT -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutEditInput"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="Update your ideas!!!"
        app:boxStrokeColor="#11e2fe"
        app:layout_constraintTop_toBottomOf="@id/imgHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="5"
            android:gravity="top"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- BUTTONS -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text="Save Changes"
        android:textColor="@android:color/white"
        app:backgroundTint="#2196F3"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/layoutEditInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnCancel"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:text="Cancel"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/layoutEditInput"
        app:layout_constraintStart_toEndOf="@id/btnSave"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>